{
  "name": "data-import-center",
  "version": "1.0.0",
  "description": "Enterprise Data Import Centre - Ingestion, Validation, Transformation, and Execution Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test dist/tests/unit/*.test.js dist/tests/unit/**/*.test.js dist/tests/integration/*.test.js",
    "test:unit": "node --test dist/tests/unit/*.test.js dist/tests/unit/**/*.test.js",
    "test:integration": "node --test dist/tests/integration/*.test.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "data-import",
    "etl",
    "data-pipeline",
    "validation",
    "multi-tenant"
  ],
  "author": "Data Import Centre Core Team",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.19",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
