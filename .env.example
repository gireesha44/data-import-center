# ==============================================================================
# DATA IMPORT CENTRE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
HOST=localhost

# Security & Multi-Tenancy Defaults
DEFAULT_ORGANIZATION_ID=org-master-101
DEFAULT_USER_ID=user-admin-01
DEFAULT_ROLES=ADMIN,IMPORT_OPERATOR,IMPORT_APPROVER
DEFAULT_PERMISSIONS=DATA_IMPORT_VIEW,DATA_IMPORT_CREATE,DATA_IMPORT_UPLOAD,DATA_IMPORT_MAP,DATA_IMPORT_VALIDATE,DATA_IMPORT_APPROVE,DATA_IMPORT_EXECUTE,DATA_IMPORT_CANCEL

# Storage Engine (Options: local, s3, gcs)
DATA_IMPORT_STORAGE_DRIVER=local
DATA_IMPORT_STORAGE_PATH=./temp/storage
DATA_IMPORT_MAX_FILE_SIZE_BYTES=104857600

# Pipeline Execution Settings
DATA_IMPORT_BATCH_SIZE=500
DATA_IMPORT_CONCURRENCY=4
DATA_IMPORT_QUEUE_ENABLED=false
DATA_IMPORT_RETENTION_DAYS=90

# Compliance & Governance
DATA_IMPORT_REQUIRE_FOUR_EYES=true
DATA_IMPORT_MAX_ROW_THRESHOLD_AUTO_APPROVE=1000
